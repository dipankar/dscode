# Dependencies
node_modules/
extension-host/node_modules/

# Build output
dist/
dist-ssr/
extension-host/dist/
extension-host/build/
extension-host/lib/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
*.local
.env
.env.*

# Tauri
/target/
/src-tauri/target/
/src-tauri/gen/

# Monaco WASM build cache
monaco-wasm/target/

# Extension data (user-installed extensions, not the extension-host source)
extensions/
!/extension-host/

# Bundled Node.js binaries (but track the hash list for integrity checks)
resources/node/
bin/node-*
!bin/allowed-hashes.json

# OS files
.DS_Store
Thumbs.db

# Editor artifacts
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Svelte
.svelte-kit/

# Vite
node_modules/.vite-cache/

# AI assistant configs
.claude/

# Documentation build output
documentation/site/

# Package locks (optional - uncomment if you want to track them)
# package-lock.json
# extension-host/package-lock.json
