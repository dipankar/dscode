{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSCode",
  "version": "0.2.0",
  "identifier": "com.dscode.devtool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": [
      "app",
      "deb",
      "msi",
      "dmg",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../extension-host/dist/**/*",
      "../extension-host/package.json"
    ],
    "externalBin": [
      "../bin/node"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "DSCode",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost ws://localhost:1420; worker-src 'self' blob:",
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main app capabilities",
          "windows": [
            "main"
          ],
          "permissions": [
            "dialog:allow-open",
            "dialog:allow-save",
            "dialog:allow-message",
            "dialog:allow-ask",
            "dialog:allow-confirm",
            "core:default",
            "core:window:allow-close",
            "core:window:allow-minimize",
            "core:window:allow-maximize",
            "core:event:allow-listen",
            "core:event:allow-emit",
            "core:path:default",
            "core:path:allow-resolve",
            "core:path:allow-normalize"
          ]
        }
      ]
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true,
      "endpoints": [],
      "pubkey": ""
    }
  }
}
